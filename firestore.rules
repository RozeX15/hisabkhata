rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection (Synced directly with Firebase Firestore for all existing and new accounts)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Wallets Collection
    match /wallets/{walletId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // Budgets Collection
    match /budgets/{budgetId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // Savings Goals Collection
    match /savingsGoals/{goalId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // Loans Collection
    match /loans/{loanId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid);
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Notifications Collection (User notifications and Global Broadcasts)
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || request.auth.token.role == 'admin');
    }

    // System Settings and Admin logs
    match /adminLogs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // App accounts persistence (synced across serverless instances and Netlify)
    match /app_accounts/{accountId} {
      allow read, write: if true;
    }

    // User presence tracking (Live users monitoring in Admin panel across Vercel, Netlify, and Localhost)
    match /userPresences/{presenceId} {
      allow read, write: if true;
    }
    match /user_presences/{presenceId} {
      allow read, write: if true;
    }

    // Live activities telemetry
    match /liveActivities/{activityId} {
      allow read, write: if true;
    }
  }
}
