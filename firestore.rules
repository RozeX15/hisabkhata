rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email in ['sultanitbangladesh@gmail.com', 'admin@hishabkhata.com']
      );
    }

    // Users Collection (Encrypted & isolated user documents)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if true;
      allow update, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Wallets Collection (Strictly owned by user or accessible by system admin)
    match /wallets/{walletId} {
      allow read, write: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Transactions Collection (Private financial data isolation)
    match /transactions/{transactionId} {
      allow read, write: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Budgets Collection
    match /budgets/{budgetId} {
      allow read, write: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Savings Goals Collection
    match /savingsGoals/{goalId} {
      allow read, write: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Loans Collection
    match /loans/{loanId} {
      allow read, write: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.isGlobal == true || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Suggestions & SuperChat
    match /suggestions/{suggestionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // System Settings and Admin logs (strictly restricted to administrators)
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App accounts persistence
    match /app_accounts/{accountId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.id == request.auth.uid ||
        isAdmin()
      );
      allow create: if true;
      allow update, delete: if isAuthenticated() && (
        resource.data.id == request.auth.uid ||
        isAdmin()
      );
    }

    // User presence tracking (Live users monitoring in Admin panel)
    match /userPresences/{presenceId} {
      allow read: if isAuthenticated();
      allow write: if true;
    }
    match /user_presences/{presenceId} {
      allow read: if isAuthenticated();
      allow write: if true;
    }

    // Live activities telemetry
    match /liveActivities/{activityId} {
      allow read: if isAdmin();
      allow write: if true;
    }
  }
}
