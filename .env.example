# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# Custom MySQL / phpMyAdmin Database Configuration
# ==============================================================================
# DB_HOST: Hostname of your MySQL server (e.g. localhost, 127.0.0.1, or cPanel/VPS IP)
DB_HOST=localhost

# DB_PORT: MySQL server port (default: 3306)
DB_PORT=3306

# DB_USER: Database username in phpMyAdmin/cPanel (default: root)
DB_USER=root

# DB_PASSWORD: Database user password
DB_PASSWORD=

# DB_NAME: Name of the database created in phpMyAdmin
DB_NAME=hishabkhata_db

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens
JWT_SECRET=hishabkhata_production_jwt_secret_key_2026

